# ===== 飞书机器人 =====
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
# 长连接模式一般不需要 Verification Token；保留占位即可
FEISHU_VERIFICATION_TOKEN=
# 收到任务 / 完成 / 失败时贴在原消息上的表情（飞书 emoji_type）
FEISHU_ACK_EMOJI=OnIt
FEISHU_DONE_EMOJI=DONE
FEISHU_ERROR_EMOJI=ERROR
# 预览确认：✅发布 / ❌取消 / OnIt重新评审
FEISHU_EMOJI_PUBLISH=CheckMark
FEISHU_EMOJI_DISCARD=CrossMark
FEISHU_EMOJI_REREVIEW=OnIt

# ===== Redis 队列 =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_KEY=lux_tasks
REDIS_DONE_PREFIX=lux_done
REDIS_MSG_DEDUP_PREFIX=lux_msg
REDIS_PENDING_PREFIX=lux_pending
DONE_TTL_SECONDS=604800

# ===== Gerrit（Local Agent） =====
GERRIT_HOST=https://gerrit.uisee.ai
GERRIT_USER=your_user
GERRIT_HTTP_PWD=your_http_password

# ===== Cursor SDK =====
# 在 https://cursor.com/dashboard/integrations 创建 User API Key
CURSOR_API_KEY=cursor_xxx
# 深度评审推荐 grok-4.6；也可用 claude-sonnet-5 / gpt-5.5 等
CURSOR_MODEL=grok-4.6
CURSOR_MODEL_EFFORT=high
CURSOR_MODEL_THINKING=true
# 指向本地代码仓；配合只读 tools 做上下文评审。不填则纯 Diff
CURSOR_WORKSPACE=

# Diff 送入模型的最大字符数（过长会头尾截断）
DIFF_MAX_CHARS=80000

# ===== 飞书项目（下载 log_part_lidar_pcap_cut）=====
# 与上面的飞书 IM 应用不是同一套凭证。在 project.feishu.cn 开发者后台创建插件后填写。
FEISHU_PROJECT_PLUGIN_ID=
FEISHU_PROJECT_PLUGIN_SECRET=
# 飞书项目里双击左下角头像复制
FEISHU_PROJECT_USER_KEY=
FEISHU_PROJECT_BASE=https://project.feishu.cn
# 本机 MeData 下载脚本
MEDATA_DOWNLOAD_SH=/home/uisee/docs/tools/medata/data_download.sh
MEDATA_DELETE_MODE=no_delete
# 单条数据下载超时（秒）
MEDATA_DOWNLOAD_TIMEOUT=3600
# 定时扫描飞书项目缺陷。默认每天 22:00 和 06:00（Asia/Shanghai）
# LUX_SCAN_ENABLED=1
# LUX_SCAN_TIMES=22:00,06:00
# LUX_SCAN_TZ=Asia/Shanghai
# 首次扫描时，评论 @ 往前回溯多少小时
# LUX_SCAN_LOOKBACK_HOURS=48
# 可选：扫完后把结果发到这个群；留空则只写 logs/lux_scan.log
# LUX_SCAN_NOTIFY_CHAT_ID=
# 可选：只扫这些 project_key，逗号分隔；留空则用插件能看到的全部空间
# FEISHU_PROJECT_SPACES=
# 主动通知发到这个会话。留空则用你最近一次跟机器人说话的会话
# LUX_NOTIFY_CHAT_ID=
# LUX_NOTIFY_OPEN_ID=
# Gerrit 轮询间隔（秒）。被加为 reviewer、CI 失败、新评论
# LUX_GERRIT_POLL_SECONDS=3600
# 第一次轮询往前看多少小时，避免把旧失败全部补发
# LUX_WATCH_LOOKBACK_HOURS=24
# 只提醒最近这段时间还没评的 reviewer 邀请
# LUX_REVIEW_MAX_AGE=30d
# LUX_REVIEW_PING_LIMIT=8
